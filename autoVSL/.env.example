# Get a free API key at https://fal.ai/dashboard/keys
# New accounts get promotional credits (~enough for 1-3 test clips)
# Put your REAL key in .env (git-ignored) — never in this file.
FAL_KEY=your-fal-key-here

# Default video model. Run ./scripts/generate-video.sh --list-models to compare.
VSL_MODEL=seedance-720p

# --- Local ComfyUI pipeline (free, GPU) -----------------------------------
# Used by scripts/generate-video-local.py — renders shots on the local GPU
# through a running ComfyUI (start it with run_nvidia_lowvram.bat) instead of
# paying fal.ai. Reads the same vsls/<slug>/kling-shots.json.
#   Stills (reliable):  python scripts/generate-video-local.py <slug> --stills
#   Video  (4GB, small): python scripts/generate-video-local.py <slug> --base 384 --frames 16
COMFYUI_URL=127.0.0.1:8188
COMFYUI_CHECKPOINT=DreamShaper_8_pruned.safetensors
COMFYUI_MOTION_MODULE=v3_sd15_mm.ckpt
