# ============================================================
# ComfyUI environment template
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; `.env.example` is tracked.
# ============================================================

# ---- HuggingFace (for gated/private model downloads) ----
# Create a token at https://huggingface.co/settings/tokens
# Required scope: read-only is enough for downloads.
HF_TOKEN=

# Optional: skip the interactive HF login prompt during installs
# HF_HUB_DISABLE_PROGRESS_BARS=1

# ---- CivitAI (for SD checkpoints / LoRAs) ----
# Find your API key at https://civitai.com/user/account
CIVITAI_TOKEN=

# ---- fal.ai (cloud model provider) ----
# Find or create at https://fal.ai/dashboard/keys
# Used by fal-based custom nodes (badayvedat/ComfyUI-Fal-API,
# xinsir's per-vendor nodes, etc.) and any backend that calls fal.
FAL_KEY=

# ---- Network bind (security) ----
# COMFYUI_HOST=127.0.0.1     # default; localhost only (safe)
# COMFYUI_HOST=0.0.0.0       # LAN exposure (only on trusted networks)
# COMFYUI_PORT=8188
# COMFYUI_LISTEN=0.0.0.0

# ---- Performance knobs (optional) ----
# Use --highvram / --gpu-only / --cpu / etc. in start.bat; these
# flags are not env-driven by ComfyUI itself, but reserved here
# for future custom launchers:
# COMFYUI_EXTRA_ARGS=

# ---- TLS / reverse proxy (optional, future) ----
# COMFYUI_TRUSTED_PROXIES=127.0.0.1
# COMFYUI_ALLOWED_ORIGINS=https://comfyui.example.com
